    },
    {
      "rule_id": "app_encryption_key",
      "provider": "app",
      "display_name": "Application encryption key",
      "env_patterns": ["ENCRYPTION_KEY"],
      "rotation_class": "manual_cutover",
      "implementation_phase": "phase_5",
      "notes": "Requires dual-read / re-encrypt strategy before switching."
