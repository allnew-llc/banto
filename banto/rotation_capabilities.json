    {
      "rule_id": "app_hmac_secret",
      "provider": "app",
      "display_name": "Application HMAC secret",
      "env_patterns": ["HMAC_SECRET"],
      "rotation_class": "manual_cutover",
      "implementation_phase": "phase_5",
      "notes": "Requires staged verifier support or coordinated token invalidation."
    },
    {
      "rule_id": "app_cron_secret",
      "provider": "app",
      "display_name": "Application cron secret",
      "env_patterns": ["CRON_SECRET"],
      "rotation_class": "manual_cutover",
      "implementation_phase": "phase_5",
      "notes": "Rotate only with coordinated scheduler/client cutover."
    }
  ]
}
