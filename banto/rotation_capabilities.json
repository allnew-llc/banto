    {
      "rule_id": "zoom_webhook_secret",
      "provider": "zoom",
      "display_name": "Zoom webhook verification secret",
      "env_patterns": ["ZOOM_WEBHOOK_SECRET_TOKEN"],
      "rotation_class": "manual_cutover",
