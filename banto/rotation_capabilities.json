    {
      "rule_id": "twilio_identifiers",
      "provider": "twilio",
      "display_name": "Twilio identifiers",
      "env_patterns": ["TWILIO_ACCOUNT_SID", "TWILIO_VERIFY_SERVICE_SID"],
      "rotation_class": "inventory_only",
      "implementation_phase": "phase_0",
      "notes": "Identifiers only; no urgent rotation value."
    },
    {
      "rule_id": "zoom_client_secret",
      "provider": "zoom",
      "display_name": "Zoom client secret",
      "env_patterns": ["ZOOM_CLIENT_SECRET"],
      "rotation_class": "propagate_only",
      "implementation_phase": "phase_2",
      "notes": "Automate distribution first."
    },
    {
      "rule_id": "zoom_identifiers",
      "provider": "zoom",
      "display_name": "Zoom identifiers",
      "env_patterns": ["ZOOM_ACCOUNT_ID", "ZOOM_CLIENT_ID"],
      "rotation_class": "inventory_only",
      "implementation_phase": "phase_0",
