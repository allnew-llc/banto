    },
    {
      "rule_id": "stripe_publishable_key",
      "provider": "stripe",
      "display_name": "Stripe publishable key",
      "env_patterns": ["NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"],
      "rotation_class": "inventory_only",
      "implementation_phase": "phase_0",
      "notes": "Public identifier; track coverage only."
    },
    {
      "rule_id": "stripe_webhook_secret",
      "provider": "stripe",
      "display_name": "Stripe webhook secret",
