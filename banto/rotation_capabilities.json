{
  "rotation_classes": {
    "full_auto": {
      "summary": "New credential can be issued, stored, pushed, and the previous credential retired through a scripted flow.",
      "operator_action": "Approve the run, monitor smoke tests, and confirm old credential revocation."
    },
    "partial_auto": {
      "summary": "Some lifecycle steps can be automated, but credential issuance or retirement still needs provider-specific confirmation.",
      "operator_action": "Use automation for inventory, validation, and propagation; keep issuance/revocation under human approval."
    },
    "propagate_only": {
      "summary": "A new value can be safely propagated once obtained, but issuance is not yet standardized in banto.",
      "operator_action": "Generate or copy the replacement value outside banto, then use banto to store and distribute it."
    },
    "inventory_only": {
      "summary": "Value is non-secret or not worth rotating during incident response.",
      "operator_action": "Track presence and target coverage only."
    },
    "manual_cutover": {
      "summary": "Rotation changes runtime behavior and needs staged rollout, dual-read support, or coordinated endpoint changes.",
      "operator_action": "Follow a dedicated runbook instead of blind overwrite."
    },
    "review_required": {
      "summary": "No rule matched. Treat as unknown until reviewed.",
      "operator_action": "Classify manually before automating."
    }
  },
  "rules": [
    {
      "rule_id": "openai_api_key",
      "provider": "openai",
      "display_name": "OpenAI API key",
      "env_patterns": ["OPENAI_API_KEY"],
      "rotation_class": "full_auto",
      "implementation_phase": "phase_3",
      "notes": "Prefer project service accounts so issuance and retirement can be fully scripted."
    },
    {
      "rule_id": "google_gemini_api_key",
      "provider": "google_gemini",
      "display_name": "Gemini API key",
      "env_patterns": ["GEMINI_API_KEY"],
      "rotation_class": "partial_auto",
      "implementation_phase": "phase_3",
      "notes": "Promote to full_auto only after project-level issuance path is proven in this workspace."
    },
    {
      "rule_id": "google_api_key",
      "provider": "google",
      "display_name": "Google API key",
      "env_patterns": ["GOOGLE_API_KEY", "GOOGLE_AI_API_KEY"],
      "rotation_class": "full_auto",
      "implementation_phase": "phase_3",
      "notes": "Use Google Cloud API Keys API when the key is project-managed."
    },
    {
      "rule_id": "database_credentials",
      "provider": "database",
      "display_name": "Database credential",
      "env_patterns": [
        "DATABASE_URL",
        "DATABASE_URL_*",
        "POSTGRES_URL",
        "POSTGRES_URL_*",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_DATABASE_URL",
        "POSTGRES_DATABASE_URL_*",
        "PGPASSWORD",
        "POSTGRES_PGPASSWORD",
        "POSTGRES_PASSWORD"
      ],
      "rotation_class": "manual_cutover",
      "implementation_phase": "phase_5",
      "notes": "Rotate database credentials with dual connection validation and rollback plan."
    },
    {
      "rule_id": "non_secret_runtime_config",
      "provider": "app",
      "display_name": "Non-secret runtime config",
      "env_patterns": [
        "NEXT_PUBLIC_*",
        "NEXTAUTH_URL",
        "COMPANY_NAME",
        "INVOICE_REGISTRATION_NUMBER",
        "RESEND_FROM_DOMAIN",
        "EKYC_PROVIDER",
        "GEMINI_API_VERSION",
        "GEMINI_LIVE_MODEL",
        "BAAS_ALLOWED_APP_IDS",
        "NEON_PROJECT_ID",
        "POSTGRES_NEON_PROJECT_ID",
        "POSTGRES_HOST",
        "POSTGRES_PGHOST",
        "POSTGRES_PGHOST_*",
        "PGHOST",
        "PGHOST_*",
        "POSTGRES_USER",
        "POSTGRES_PGUSER",
        "PGUSER",
        "POSTGRES_DATABASE",
        "POSTGRES_PGDATABASE",
        "PGDATABASE"
      ],
      "rotation_class": "inventory_only",
      "implementation_phase": "phase_0",
      "notes": "Configuration or identifier; track coverage but do not rotate as a secret."
    },
    {
      "rule_id": "upstash_redis_tokens",
      "provider": "upstash",
      "display_name": "Upstash Redis credential",
      "env_patterns": ["UPSTASH_REDIS_REST_TOKEN", "UPSTASH_REDIS_REST_URL"],
      "rotation_class": "manual_cutover",
      "implementation_phase": "phase_5",
      "notes": "Rotate Redis credentials with provider-side token issuance and cache/session impact review."
